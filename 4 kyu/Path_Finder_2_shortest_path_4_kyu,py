def path_finder(maze):
    # Разбиваем лабиринт на строки
    maze = maze.split('\n')
    n = len(maze)
    
    # Если стартовая и конечная позиции совпадают
    if n == 1:
        return 0
    
    # Очередь для BFS: (строка, колонка, количество шагов)
    from collections import deque
    queue = deque([(0, 0, 0)])
    
    # Посещенные клетки
    visited = [[False] * n for _ in range(n)]
    visited[0][0] = True
    
    # Направления движения: вверх, вниз, влево, вправо
    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]
    
    while queue:
        row, col, steps = queue.popleft()
        
        # Проверяем все направления
        for dr, dc in directions:
            new_row = row + dr
            new_col = col + dc
            
            # Проверяем, что мы в пределах лабиринта
            if 0 <= new_row < n and 0 <= new_col < n:
                # Проверяем, что клетка не посещена и не является стеной
                if not visited[new_row][new_col] and maze[new_row][new_col] == '.':
                    # Если достигли выхода
                    if new_row == n - 1 and new_col == n - 1:
                        return steps + 1
                    
                    visited[new_row][new_col] = True
                    queue.append((new_row, new_col, steps + 1))
    
    # Если выход не достигнут
    return False
